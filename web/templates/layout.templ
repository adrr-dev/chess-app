package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script defer src="https://unpkg.com/alpinejs@3.15.0/dist/cdn.min.js"></script>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cm-chessboard@8.6.0/assets/chessboard.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cm-chessboard@8.6.0/assets/extensions/markers/markers.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cm-chessboard@8.6.0/assets/extensions/arrows/arrows.css"/>
			<style>
				:root { --bl: #EBD2B1; --bd: #A5714A; }
				.board { display: grid; grid-template-columns: repeat(8, 1fr); }
				.sq { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: clamp(20px, 4vw, 40px); line-height: 1; }
				.sq.light { background: var(--bl); }
				.sq.dark { background: var(--bd); }
				.sq.hl { outline: 3px solid #eab308; outline-offset: -3px; }
				.piece-w { color: #fafafa; text-shadow: 0 0 2px #000, 0 1px 3px #000; }
				.piece-b { color: #141414; text-shadow: 0 0 3px rgba(255,255,255,.7); }
			</style>
		</head>
		<body class="bg-stone-900 text-stone-100 min-h-screen">
			<main class="max-w-5xl mx-auto p-4">
				{ children... }
			</main>
		</body>
	</html>
}
